# ===== Umum =====
PORT=3000
# URL publik website (dipakai untuk callback Tripay & return URL)
BASE_URL=http://localhost:3000
STORE_NAME=RhineShop
STORE_EMAIL=cs@rhineshop.id
NODE_ENV=development
# Isi dengan string acak panjang, contoh hasil: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ===== Digiflazz (https://member.digiflazz.com -> Atur Koneksi -> API) =====
# Kosongkan untuk mode simulasi.
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
# Secret webhook (Atur Koneksi -> Webhook). URL webhook: {BASE_URL}/api/callback/digiflazz
DIGIFLAZZ_WEBHOOK_SECRET=
# true = pakai Development Key / mode testing (saldo tidak terpotong). Ubah ke false saat produksi.
DIGIFLAZZ_TESTING=true

# ===== Tripay (https://tripay.co.id/member) =====
# Kosongkan untuk mode simulasi. URL callback: {BASE_URL}/api/callback/tripay
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_SANDBOX=true

# ===== Cek nickname (opsional, layanan pihak ketiga) =====
# Placeholder: {game} {id} {zone}
NICKNAME_API_URL=
NICKNAME_API_KEY=
