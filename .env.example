# ===== Database (Supabase) =====
# Supabase Dashboard -> tombol "Connect" -> "Transaction pooler" (port 6543). Ganti [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ===== Umum =====
PORT=3000
# URL publik website (callback Tripay & return URL). Di Vercel boleh dikosongkan (otomatis domain produksi).
BASE_URL=
STORE_NAME=RhineShop
STORE_EMAIL=cs@rhineshop.id
# String acak panjang. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Secret untuk Vercel Cron (string acak). Vercel otomatis mengirimnya ke /api/callback/cron.
CRON_SECRET=

# ===== Digiflazz (https://member.digiflazz.com -> Atur Koneksi -> API) =====
# Kosongkan untuk mode simulasi.
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
# Secret webhook (Atur Koneksi -> Webhook). URL webhook: {BASE_URL}/api/callback/digiflazz
DIGIFLAZZ_WEBHOOK_SECRET=
# true = mode testing (saldo tidak terpotong). Ubah ke false saat produksi.
DIGIFLAZZ_TESTING=true

# ===== Tripay (https://tripay.co.id/member) =====
# Kosongkan untuk mode simulasi. URL callback: {BASE_URL}/api/callback/tripay
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_SANDBOX=true

# ===== Cek nickname (opsional, layanan pihak ketiga) =====
# Placeholder: {game} {id} {zone}
NICKNAME_API_URL=
NICKNAME_API_KEY=
